# Copy to .env in this same directory and fill in real values.
# docker compose (run from this dotnet/ directory) loads .env automatically.

# Clerk JWT issuer used by the Api for bearer-token validation, e.g. https://your-instance.clerk.accounts.dev
CLERK_AUTHORITY=

# Clerk keys used by the frontend (publishable key is baked into the build; secret key is read at runtime)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

OPENAI_API_KEY=
SCRAPINGBEE_API_KEY=

# S3-compatible object storage for uploaded documents (Tigris by default, matching the
# original Python backend). AWS_REGION and AWS_S3_ENDPOINT_URL default to Tigris's values
# below if left unset - only override them if you're pointing at a different provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_S3_ENDPOINT_URL=https://t3.storage.dev

# Cohere Rerank API key, used only when a project has reranking_enabled=true
COHERE_API_KEY=
